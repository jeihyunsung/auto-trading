# ETH paper-trading config
# Usage: env $(cat .env.eth | grep -v '^#' | xargs) uv run python -m trading.main --mode single
# Or set as DOTENV_PATH if you prefer python-dotenv to load it directly.

# Asset routing — picks up Phase 1 settings
TRADING_ASSET=ETH

# SAFE: paper mode does not execute real orders even though API keys are valid
TRADING_MODE=paper

# Isolated sandbox — separate file path because TRADING_ASSET=ETH routes to
# logs/eth/isolated_balance_eth.json (BTC's logs/isolated_balance.json untouched)
ISOLATED_MODE=true
ISOLATED_CAPITAL_KRW=500000

# Risk — slightly looser stop-loss than BTC because ETH is more volatile,
# but XRP-style adjustments only after observed behavior
STOP_LOSS_PCT=2.5
TAKE_PROFIT_PCT=2.0

# Hysteresis — same default as BTC for now; revisit after 1-2 days of data
HYSTERESIS_MODE=streaming

# Pattern agent off (kept disabled from BTC's lessons — matplotlib freezes)
PATTERN_AGENT_ENABLED=false

# Per-asset logs route to logs/eth/ via settings.asset_log_dir
LOG_DIR=logs

# API keys — share with .env loaded by pydantic-settings; uncomment if you
# want this file fully self-contained instead.
# UPBIT_ACCESS_KEY=...
# UPBIT_SECRET_KEY=...
# OPENAI_API_KEY=...
# CMC_API_KEY=...
