# Upbit API (조회/주문)
# https://upbit.com/mypage/open_api_management 에서 발급
UPBIT_ACCESS_KEY=your-access-key
UPBIT_SECRET_KEY=your-secret-key

# CoinMarketCap API
# https://coinmarketcap.com/api/ 에서 발급 (Basic Plan: 무료)
CMC_API_KEY=your-cmc-api-key

# OpenAI API
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Slack 알림 (선택)
# https://api.slack.com/messaging/webhooks 에서 생성
SLACK_WEBHOOK_URL=

# Email 알림 (선택)
# Gmail 사용 시: 앱 비밀번호 필요 (https://myaccount.google.com/apppasswords)
EMAIL_ENABLED=false
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_RECIPIENT=your-email@gmail.com

# 운영 모드
TRADING_MODE=paper  # paper | live

# 리스크 관리
MAX_DAILY_LOSS_PCT=3.0
MAX_POSITION_PCT=50.0
MIN_ORDER_KRW=5000

# 로깅
LOG_LEVEL=INFO
LOG_DIR=logs
